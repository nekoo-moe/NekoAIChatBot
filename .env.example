# ==========================================
# NEKOAI DISCORD BOT CONFIGURATION
# ==========================================

# Discord Bot Token & Client ID (Lấy từ https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_bot_client_id_here

# Lựa chọn LLM Provider: 'auto', 'gemini', hoặc 'openrouter' (Mặc định: 'auto')
LLM_PROVIDER=auto

# Google Gemini API Key(s) (Lấy miễn phí tại https://aistudio.google.com/apikey)
# Hỗ trợ 1 key hoặc nhiều key xoay tua phân cách bởi dấu phẩy
GEMINI_API_KEYS=AIzaSyxxxxxxxxxxxxxxxxxxxx,AIzaSyyyyyyyyyyyyyyyyyyyy
DEFAULT_GEMINI_MODEL=gemini-2.0-flash

# OpenRouter API Key(s) (Hỗ trợ 1 key hoặc nhiều key xoay tua phân cách bởi dấu phẩy)
# Đăng ký miễn phí tại https://openrouter.ai/keys
OPENROUTER_API_KEYS=sk-or-v1-xxxxxxxxxxxxxxxxxxxx,sk-or-v1-yyyyyyyyyyyyyyyyyyyy

# Tùy chọn model mặc định ưu tiên trên OpenRouter (Nếu để trống, bot tự động quét và xoay tua)
# Ví dụ: google/gemma-4-31b-it:free, google/gemma-4-26b-a4b-it:free, minimax/minimax-m3:free
DEFAULT_TEXT_MODEL=
DEFAULT_VISION_MODEL=

# Tần suất tự động làm mới danh sách free model từ OpenRouter (Giờ)
MODEL_FETCH_INTERVAL_HOURS=6

# ==========================================
# BẢO MẬT & RATE LIMITING
# ==========================================
# Giới hạn số lượt gọi bot cho mỗi người dùng (mặc định: 5 requests / 60 giây)
RATE_LIMIT_USER_MAX_REQUESTS=5
RATE_LIMIT_USER_WINDOW_SECONDS=60

# Giới hạn số lượt gọi bot trong cùng 1 kênh Discord (mặc định: 15 requests / 60 giây)
RATE_LIMIT_CHANNEL_MAX_REQUESTS=15
RATE_LIMIT_CHANNEL_WINDOW_SECONDS=60

# Mức độ phòng vệ Prompt Injection (strict | high | moderate)
INJECTION_DEFENSE_LEVEL=high

# ==========================================
# WEB SEARCH (100% NO KEY REQUIRED)
# ==========================================
# Bật/tắt công cụ tìm kiếm thời gian thực
ENABLE_WEB_SEARCH=true

# Tùy chọn URL SearXNG nếu bạn có instance riêng (để trống sẽ dùng public nodes + Google Scraper + Wikipedia)
SEARXNG_CUSTOM_URL=

# ==========================================
# ĐỊNH DẠNG THẺ CẢM XÚC <|ACT ...|> TRÊN DISCORD
# ==========================================
# badges: Hiển thị đẹp kèm nhãn cảm xúc [✨ Happy] hoặc [🤔 Thinking]
# clean: Loại bỏ thẻ streaming để nội dung tin nhắn thuần chữ tự nhiên
# raw: Giữ nguyên thẻ gốc <|ACT ...|> (hữu ích khi nối sang stage Vtuber)
PARSE_ACT_TOKENS=badges

